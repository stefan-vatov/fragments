{
  "name": "fragments",
  "version": "1.6.2",
  "description": "A fast, local-first snippet library for Obsidian",
  "keywords": [
    "obsidian",
    "obsidian-plugin"
  ],
  "homepage": "https://github.com/stefan-vatov/fragments#readme",
  "bugs": {
    "url": "https://github.com/stefan-vatov/fragments/issues"
  },
  "license": "MIT",
  "author": "Stefan Vatov (TheThracian)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stefan-vatov/fragments.git"
  },
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "check": "pnpm run build && pnpm run lint && pnpm run format:check && pnpm run test",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run --no-ci",
    "release:version": "node scripts/set-version.mjs",
    "lint": "oxlint src --config oxlint.config.mjs --type-aware --type-check --deny-warnings",
    "lint:fix": "oxlint src --config oxlint.config.mjs --type-aware --type-check --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "mutation": "stryker run"
  },
  "dependencies": {
    "effect": "^4.1.4",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@thethracian/oxlint-config": "^0.14.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "obsidian": "1.14.4",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.12.4"
}
